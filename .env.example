# ---------------------------------------------------------------------------
# BroadcastHub environment variables
# ---------------------------------------------------------------------------

# Database (PostgreSQL — Neon or any postgres provider)
# Replace USER:PASSWORD@HOST with your own credentials. Never commit the real URL.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# SQLite alternative (for local-only development):
# DATABASE_URL=file:./dev.db

# ---------------------------------------------------------------------------
# OpenAI (spec #72, #101)
# Keys are server-side ONLY. Never expose to the browser.
# When OPENAI_API_KEY is unset, AI features gracefully fall back to a built-in
# demo provider (or are disabled, depending on org AI settings).
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional: base URL override (e.g. for OpenAI-compatible endpoints)
# OPENAI_BASE_URL=

# ---------------------------------------------------------------------------
# Admin panel (server-side only — never expose to the browser)
# Credentials are validated server-side and stored in an httpOnly cookie.
# ---------------------------------------------------------------------------
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=BroadcastHub
